# BandrewPay platform configuration — copy to .env.local (never commit).
# Semua nilai di bawah WAJIB diganti di produksi.
#
# PENTING: .env hanya FALLBACK/BOOTSTRAP. Semua kunci di bawah (kecuali
# DATABASE_PATH & GOPAY_SESSION_FILE) bisa dioverride dari dashboard
# Admin > Pengaturan, dan override dashboard SELALU menang. Nilai env baru
# terpakai lagi jika override dashboard di-reset (tombol "reset").

# Public base URL gateway (dipakai menyusun payment_url untuk integrator)
APP_URL=http://localhost:4100

# Secret penanda tangan sesi admin (min 32 karakter acak)
SESSION_SECRET=CHANGE_ME_MIN_32_RANDOM_CHARS_SECRET

# Shared secret integrasi Paymenter -> gateway (HMAC). Ganti wajib.
INTEGRATION_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET

# Seed admin pertama (hanya dipakai `npm run seed` saat DB masih kosong).
# Setelah itu ganti password dari dashboard: Admin > Pengaturan > Ganti Password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# SQLite database file (relative ke folder platform/) — TIDAK BISA via dashboard
DATABASE_PATH=./data/gateway.db

# Provider GoBiz / GoPay Merchant
GOPAY_MERCHANT_ID=
GOPAY_SESSION_FILE=../.GOPAY_SESI_JANGAN_DIHAPUS.json

# Template QRIS statis EMVCo (bisa juga diisi via dashboard Settings; checksum divalidasi)
QRIS_STATIC=

# Perilaku pembayaran
PAYMENT_TTL_SECONDS=300      # 30..86400
CALLBACK_TIMEOUT_MS=10000    # 1000..60000

# Monitor coordinator
MONITOR_POLL_INTERVAL_MS=8000   # 4000..300000 (jangan diturunkan — anti-ban)
MONITOR_VIEWER_LEASE_MS=25000   # 8000..120000
MONITOR_TICK_MS=4000            # 1000..60000
