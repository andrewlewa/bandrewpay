{
  "name": "bandrewpay-platform",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Secure QRIS payment gateway platform with Paymenter integration",
  "scripts": {
    "dev": "next dev --port 4100",
    "build": "next build",
    "start": "next start --port 4100",
    "seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed.ts",
    "import-session": "node --env-file-if-exists=.env --experimental-strip-types scripts/import-session.ts",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "test": "node --test tests/unit/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "audit:deps": "npm audit --omit=dev && npm outdated"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.3.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3"
  }
}
